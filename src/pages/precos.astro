---
// Preços (visual novo, out/2026). A comparação segue o que o sistema libera para
// cada plano (routers/billing.py e menuConfiguracoes.ts, conferidos em 22/10/2026).
// Ficaram de fora, por não serem verdade hoje: "trilha de auditoria básica ou
// completa", "suporte prioritário", "AES-256 no prontuário", secretária só no Clínica
// (o Individual também tem uma) e "dados sempre exportáveis".
import LayoutNovo from '../layouts/LayoutNovo.astro';
import TopoFixo from '../components/rascunho/TopoFixo.astro';
import Precos from '../components/novo/Precos.astro';
import PalcoSolto from '../components/novo/PalcoSolto.astro';
import Equipe from '../components/novo/telas/Equipe.astro';
import Repasse from '../components/novo/telas/Repasse.astro';
import Compartilhamento from '../components/novo/telas/Compartilhamento.astro';
import Painel from '../components/novo/telas/Painel.astro';
import Perguntas from '../components/novo/Perguntas.astro';
import Comecar from '../components/novo/Comecar.astro';
import Rodape from '../components/novo/Rodape.astro';
import { PLANS } from '../data/pricing.ts';
import { SITE } from '../data/site.ts';
import { PERGUNTAS } from '../data/perguntas.ts';

const title = 'Preços: planos Individual e Clínica';
const description =
  'Plano Individual por R$ 39 por mês e Clínica por R$ 69 por mês, com 30 dias grátis sem cartão. Sem fidelidade: cancele quando quiser.';

const productLd = PLANS.map((plan) => ({
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `Sistema Psicologia · Plano ${plan.name}`,
  description: plan.tagline,
  brand: { '@type': 'Brand', name: SITE.name },
  offers: {
    '@type': 'Offer',
    price: plan.monthly.toFixed(2),
    priceCurrency: 'BRL',
    url: SITE.registerUrl,
    availability: 'https://schema.org/InStock',
  },
}));

// [o que muda, Individual, Clínica]; '' quando o plano não tem
const diferencas: [string, string, string][] = [
  ['Profissionais', '1', 'Até 5 (você e mais 4)'],
  ['Secretárias', '1', '2'],
  ['Agenda da equipe com salas e aviso de conflito', '', 'Incluído'],
  ['Repasse de cada profissional, calculado', '', 'Incluído'],
  ['Escolher quem da equipe lê o prontuário', '', 'Incluído'],
  ['Escolher o que cada profissional vê da agenda dos colegas', '', 'Incluído'],
  ['Preço no plano mensal', 'R$ 39 por mês', 'R$ 69 por mês'],
  ['Preço no plano anual', 'R$ 399 por ano', 'R$ 699 por ano'],
];

const nosDois = [
  ['Pacientes sem limite.', 'Não há cobrança por paciente cadastrado.'],
  ['Agenda com reservas pelo seu link.', 'A página pode ficar dentro do seu site, e o lembrete sai por e-mail 24 horas antes.'],
  ['Google Agenda nos dois sentidos.', 'O que entra num lado aparece no outro.'],
  ['Prontuário completo.', 'Evolução por sessão, anamnese por link, registro de humor, arquivos e casal, família e grupo.'],
  ['Documentos em um minuto.', 'Atestado, declaração e recibo a partir dos seus modelos.'],
  ['Financeiro do consultório.', 'Mensalidade ou sessão avulsa, crédito do paciente e política de cancelamento.'],
  ['Nota fiscal e Receita Saúde.', 'NFS-e no padrão nacional para quem tem CNPJ e o arquivo do Receita Saúde para pessoa física.'],
  ['Portal do paciente.', 'Entrada com código, sem senha, com o que você liberar para cada um.'],
  ['Mensagens e e-mails.', 'Mensagens prontas para o WhatsApp, e-mails com a sua marca e comunicado aos pacientes.'],
  ['Dados que você já tem.', 'Importação da planilha do Psicomanager e da sua agenda do Google.'],
];

const dePlano = [
  'Preciso de cartão para testar?',
  'Pago a mais por profissional na clínica?',
  'Posso cancelar quando quiser?',
  'Preciso ter CNPJ para emitir nota fiscal?',
];
const perguntasDePlano = PERGUNTAS.filter((p) => dePlano.includes(p.q));
---
<LayoutNovo title={title} description={description} jsonLd={productLd}>
  <TopoFixo base="/" atual="/precos" />

  <main id="inicio">
    <Precos pagina />

    <section class="banda app" aria-labelledby="t-comparar">
      <div class="banda-miolo">
        <h2 id="t-comparar" class="entra">O que muda entre os planos</h2>
        <table class="comparar">
          <thead>
            <tr><td></td><th scope="col">Individual</th><th scope="col" class="clinica-c">Clínica</th></tr>
          </thead>
          <tbody>
            {diferencas.map(([o_que, individual, clinica], i) => (
              <tr class="entra em-fila" style={`--i:${i}`}>
                <th scope="row">{o_que}</th>
                <td class:list={[{ nao: !individual }]} data-plano="Individual">{individual || 'Não tem'}</td>
                <td class="sim" data-plano="Clínica">{clinica}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="rodape-i">Mais de 5 profissionais ou mais secretárias? <a href={`https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent('Olá! Quero saber do plano personalizado do Sistema Psicologia.')}`} target="_blank" rel="noopener">Fale com a gente sobre um plano personalizado</a>.</p>
      </div>
    </section>

    <section class="banda escuro" aria-labelledby="t-clinica">
      <div class="banda-miolo">
        <h2 id="t-clinica" class="entra">O que o Clínica acrescenta</h2>
      </div>
      <div class="banda-grade palco-esquerda linha-palco">
        <div>
          <h3 class="entra">A agenda da equipe, com as salas.</h3>
          <p class="texto-i entra d1">Cada profissional tem a sua agenda, e o sistema não deixa marcar duas sessões na mesma sala no mesmo horário.</p>
        </div>
        <PalcoSolto Tela={Equipe} />
      </div>
      <div class="banda-grade linha-palco">
        <div>
          <h3 class="entra">O repasse de cada profissional, calculado.</h3>
          <p class="texto-i entra d1">Do valor recebido, o sistema desconta a taxa do meio de pagamento e a taxa da clínica, e aplica o acordo de cada profissional.</p>
        </div>
        <PalcoSolto Tela={Repasse} />
      </div>
      <div class="banda-grade palco-esquerda linha-palco">
        <div>
          <h3 class="entra">Quem da equipe lê o quê.</h3>
          <p class="texto-i entra d1">O prontuário pode ficar com quem escreveu, com quem atende o paciente ou com a equipe toda, e dá para mudar paciente por paciente. A secretária não lê prontuário em nenhum dos planos.</p>
        </div>
        <PalcoSolto Tela={Compartilhamento} />
      </div>
    </section>

    <section class="banda claro" aria-labelledby="t-nos-dois">
      <div class="banda-grade lista-e-palco">
        <div>
          <h2 id="t-nos-dois" class="entra">Nos dois planos</h2>
          <ul class="regras" style="margin-top:40px">
            {nosDois.map(([t, s], i) => <li class="entra em-fila" style={`--i:${i % 4}`}><b>{t}</b><span>{s}</span></li>)}
          </ul>
        </div>
        <div class="palco-fixo">
          <PalcoSolto Tela={Painel} />
        </div>
      </div>
    </section>

    <Perguntas titulo="Dúvidas sobre o plano" itens={perguntasDePlano} anima />
    <Comecar anima />
  </main>
  <Rodape />
  <script>
    import '../scripts/palco.ts';
  </script>
</LayoutNovo>
