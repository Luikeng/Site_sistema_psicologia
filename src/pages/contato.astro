---
// Contato (visual novo, out/2026). WhatsApp (51) 99274-9130 e, por enquanto, um e-mail
// só, o contato@, também para pedidos de titulares pela LGPD (decisão dele em 23/10/2026:
// o dpo@ não existe). O horário é o que a página de Suporte do próprio sistema informa.
import LayoutNovo from '../layouts/LayoutNovo.astro';
import TopoFixo from '../components/rascunho/TopoFixo.astro';
import Comecar from '../components/novo/Comecar.astro';
import Perguntas from '../components/novo/Perguntas.astro';
import Rodape from '../components/novo/Rodape.astro';
import { SITE } from '../data/site.ts';

const title = 'Contato';
const description =
  'Fale com o Sistema Psicologia pelo WhatsApp ou por e-mail: dúvidas de plano, suporte, parcerias e privacidade (LGPD).';

const n = SITE.whatsapp;
const telefone = `+${n.slice(0, 2)} (${n.slice(2, 4)}) ${n.slice(4, 9)}-${n.slice(9)}`;
const zap = (texto: string) => `https://wa.me/${n}?text=${encodeURIComponent(texto)}`;

const canais = [
  { nome: 'WhatsApp', texto: telefone, href: zap('Olá! Tenho uma dúvida sobre o Sistema Psicologia.'), uso: 'Para dúvidas, suporte e conversa sobre planos. De segunda a sexta, das 9h às 18h.', fora: true },
  { nome: 'E-mail', texto: SITE.contactEmail, href: `mailto:${SITE.contactEmail}`, uso: 'Para dúvidas de uso, erros, importação de dados, parcerias e pedidos de titulares pela LGPD, com resposta em até 15 dias.', fora: false },
];
---
<LayoutNovo title={title} description={description}>
  <TopoFixo base="/" atual="/contato" />
  <header class="cabeca-i">
    <div class="cabeca-grade contato-grade">
      <div>
        <h1>Fale com a gente</h1>
        <p class="frase-i">Quem responde é gente, em português. Dúvida de plano, de nota fiscal, de importação de dados ou de LGPD: escolha o canal.</p>
        <div class="botoes-i">
          <a class="botao" href={canais[0].href} target="_blank" rel="noopener">Abrir conversa no WhatsApp</a>
        </div>
      </div>
      <ul class="canais">
        {canais.map((c, i) => (
          <li class="entra em-fila" style={`--i:${i}`}>
            <span class="canal-nome">{c.nome}</span>
            <a href={c.href} target={c.fora ? '_blank' : undefined} rel={c.fora ? 'noopener' : undefined}>{c.texto.includes('@') ? <>{c.texto.split('@')[0]}@<wbr />{c.texto.split('@')[1]}</> : c.texto}</a>
            <span class="canal-uso">{c.uso}</span>
          </li>
        ))}
      </ul>
    </div>
  </header>

  <main id="inicio">
    <section class="banda claro" aria-labelledby="t-personalizado">
      <div class="banda-grade">
        <div>
          <h2 id="t-personalizado" class="entra">Precisa de um plano diferente?</h2>
          <p class="texto-i entra d1">Mais de 5 profissionais, mais secretárias ou um jeito diferente de trabalhar: a gente monta o plano com você.</p>
          <div class="botoes-i">
            <a class="botao" href={zap('Olá! Quero saber do plano personalizado do Sistema Psicologia.')} target="_blank" rel="noopener">Falar sobre plano personalizado</a>
            <a class="link-seta" href="/precos">Ver os planos</a>
          </div>
        </div>
        <div>
          <p class="texto-i entra d2">Vindo de outro sistema? Se for o Psicomanager, os pacientes e as sessões entram pela planilha exportada de lá, com opção de desfazer, e a agenda do Google também pode ser importada. Para outros casos, conte para a gente o que você usa hoje.</p>
        </div>
      </div>
    </section>

    <Perguntas anima />
    <Comecar anima />
  </main>
  <Rodape />
  <script>
    import '../scripts/palco.ts';
  </script>
</LayoutNovo>
