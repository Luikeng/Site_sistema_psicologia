---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Status do Sistema';
const description =
  'Status em tempo real dos componentes do Sistema Psicologia. Esta página consulta nossos serviços a cada vez que é carregada.';
---

<BaseLayout title={title} description={description} noindex={true}>
  <section class="bg-gradient-to-b from-blue-50/60 to-white py-16 sm:py-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-semibold tracking-wider uppercase border border-blue-100">
          Transparência
        </span>
        <h1 class="mt-4 text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900">
          Status do Sistema
        </h1>
        <p class="mt-3 text-base text-slate-600">
          Como somos uma equipe pequena, preferimos te avisar em tempo real. Esta página consulta
          nossos serviços agora, sem cache.
        </p>
      </div>

      <!-- Card grande de status overall -->
      <div
        id="overall-card"
        class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden"
      >
        <div id="overall-banner" class="px-6 py-5 flex items-center gap-4 bg-slate-50 border-b border-slate-200">
          <div id="overall-dot" class="w-3 h-3 rounded-full bg-slate-400 animate-pulse"></div>
          <div class="flex-1">
            <div id="overall-label" class="text-lg font-bold text-slate-900">Verificando...</div>
            <div id="overall-sub" class="text-sm text-slate-500">Consultando a API agora.</div>
          </div>
          <button
            id="refresh-btn"
            type="button"
            class="hidden sm:inline-flex items-center gap-2 px-3 py-1.5 rounded-lg text-sm font-semibold text-slate-700 border border-slate-200 hover:bg-slate-50 transition"
          >
            ↻ Reverificar
          </button>
        </div>

        <!-- Lista de componentes -->
        <ul id="components-list" class="divide-y divide-slate-100">
          <li class="px-6 py-4 flex items-center gap-3 text-slate-500 text-sm">
            <span class="w-2 h-2 rounded-full bg-slate-300 animate-pulse"></span>
            Aguardando primeira resposta...
          </li>
        </ul>

        <div class="px-6 py-3 bg-slate-50 border-t border-slate-100 text-xs text-slate-500 flex flex-wrap items-center justify-between gap-2">
          <span id="checked-at">Última verificação: —</span>
          <span>Auto-refresh a cada 60s</span>
        </div>
      </div>

      <!-- Como reportar / contato -->
      <div class="mt-10 rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-sm">
        <h2 class="text-lg font-bold text-slate-900">Algum problema?</h2>
        <p class="mt-2 text-sm text-slate-600 leading-relaxed">
          Se essa página mostra tudo verde mas você está com dificuldade, pode ser cache do
          navegador (atalho <kbd class="px-1.5 py-0.5 bg-slate-100 border border-slate-200 rounded text-xs font-mono">Ctrl+Shift+R</kbd>)
          ou conexão local. Persistindo, manda mensagem:
        </p>
        <div class="mt-4 flex flex-wrap gap-3 text-sm">
          <a
            href="mailto:ads.sistemapsicologia@gmail.com"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-blue-600 text-white font-semibold hover:bg-blue-700 transition"
          >
            ✉ Email do suporte
          </a>
          <a
            href="/"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-slate-200 text-slate-700 font-semibold hover:bg-slate-50 transition"
          >
            ← Voltar pro site
          </a>
        </div>
      </div>

      <p class="mt-8 text-center text-xs text-slate-500">
        Sistema Psicologia · CRP 07/35759 · sistemapsicologia.com.br
      </p>
    </div>
  </section>

  <script is:inline>
    // URL do backend prod. Mantido fixo aqui (pagina publica, sem env do Vite).
    const API_BASE = 'https://apc-backend-353388831391.southamerica-east1.run.app';

    const ui = {
      banner: document.getElementById('overall-banner'),
      dot: document.getElementById('overall-dot'),
      label: document.getElementById('overall-label'),
      sub: document.getElementById('overall-sub'),
      list: document.getElementById('components-list'),
      checkedAt: document.getElementById('checked-at'),
      refresh: document.getElementById('refresh-btn'),
    };

    const STATE = {
      ok: {
        dot: 'bg-emerald-500 ring-4 ring-emerald-100',
        banner: 'bg-emerald-50',
        label: 'Tudo operacional',
        sub: 'Todos os sistemas estão respondendo normalmente.',
      },
      degraded: {
        dot: 'bg-amber-500 ring-4 ring-amber-100',
        banner: 'bg-amber-50',
        label: 'Operação degradada',
        sub: 'Algum componente está mais lento que o normal. Você pode notar atraso.',
      },
      down: {
        dot: 'bg-rose-500 ring-4 ring-rose-100',
        banner: 'bg-rose-50',
        label: 'Incidente em andamento',
        sub: 'Estamos trabalhando pra restabelecer. Acompanhe esta página.',
      },
      unknown: {
        dot: 'bg-slate-400 animate-pulse',
        banner: 'bg-slate-50',
        label: 'Não foi possível verificar',
        sub: 'Falha ao consultar a API. Pode ser problema temporário de rede do seu lado.',
      },
    };

    const COMPONENT_LABEL = {
      api: 'API · Backend',
      database: 'Banco de dados',
    };

    function applyState(state) {
      const s = STATE[state] || STATE.unknown;
      ui.dot.className = 'w-3 h-3 rounded-full ' + s.dot;
      ui.banner.className =
        'px-6 py-5 flex items-center gap-4 border-b border-slate-200 ' + s.banner;
      ui.label.textContent = s.label;
      ui.sub.textContent = s.sub;
    }

    function renderComponents(components) {
      ui.list.innerHTML = '';
      const order = ['api', 'database'];
      const seen = new Set();
      for (const key of order) {
        if (components[key]) {
          ui.list.appendChild(renderRow(key, components[key]));
          seen.add(key);
        }
      }
      for (const [key, val] of Object.entries(components)) {
        if (!seen.has(key)) ui.list.appendChild(renderRow(key, val));
      }
    }

    function renderRow(key, info) {
      const li = document.createElement('li');
      li.className = 'px-6 py-4 flex items-center gap-4';
      const status = info.status || 'unknown';
      const dotClass = {
        ok: 'bg-emerald-500',
        degraded: 'bg-amber-500',
        down: 'bg-rose-500',
      }[status] || 'bg-slate-400';
      const statusLabel = {
        ok: 'Operacional',
        degraded: 'Degradado',
        down: 'Indisponível',
      }[status] || 'Desconhecido';
      const statusColor = {
        ok: 'text-emerald-700',
        degraded: 'text-amber-700',
        down: 'text-rose-700',
      }[status] || 'text-slate-500';
      const extra =
        info.latency_ms != null
          ? ' · ' + info.latency_ms + ' ms'
          : info.error
          ? ' · ' + info.error
          : '';
      li.innerHTML =
        '<span class="w-2.5 h-2.5 rounded-full ' + dotClass + '"></span>' +
        '<div class="flex-1">' +
        '<div class="font-semibold text-slate-900 text-sm">' +
        (COMPONENT_LABEL[key] || key) +
        '</div>' +
        '<div class="text-xs text-slate-500">' +
        statusLabel +
        extra +
        '</div>' +
        '</div>';
      return li;
    }

    function fmtTime(epochSeconds) {
      try {
        const d = new Date((epochSeconds || Date.now() / 1000) * 1000);
        return d.toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' });
      } catch {
        return new Date().toLocaleString('pt-BR');
      }
    }

    async function check() {
      try {
        const ctrl = new AbortController();
        const t = setTimeout(() => ctrl.abort(), 6000);
        const res = await fetch(API_BASE + '/status', {
          cache: 'no-store',
          signal: ctrl.signal,
        });
        clearTimeout(t);
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const data = await res.json();
        applyState(data.status || 'unknown');
        renderComponents(data.components || {});
        ui.checkedAt.textContent = 'Última verificação: ' + fmtTime(data.checked_at);
      } catch (e) {
        applyState('unknown');
        ui.list.innerHTML =
          '<li class="px-6 py-4 text-sm text-slate-500">Não foi possível consultar a API agora.</li>';
        ui.checkedAt.textContent = 'Última tentativa: ' + fmtTime();
      }
    }

    check();
    setInterval(check, 60000);
    ui.refresh?.addEventListener('click', check);
  </script>
</BaseLayout>
