---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeatureLanding from '../../components/FeatureLanding.astro';
import CTA from '../../components/CTA.astro';
import { FEATURES } from '../../data/features.ts';

const feature = FEATURES.find((f) => f.slug === 'prontuario-eletronico')!;

const title = 'Prontuário Eletrônico para psicólogos · LGPD + CFP 01/2009';
const description =
  'Registro de sessões, anamnese estruturada e evolução com trilha de auditoria por acesso, RBAC granular e adequação às Resoluções CFP 01/2009 e LGPD.';

const benefits = [
  { icon: 'ShieldCheck' as const, title: 'Conformidade CFP + LGPD', description: 'Atende a Resolução CFP nº 01/2009 (registro datado, identificado, fidedigno) e a Resolução nº 11/2018 (atendimento online). Você é Controlador dos dados; nós somos Operador.' },
  { icon: 'BookText' as const, title: 'Estrutura clínica organizada', description: 'Anamnese inicial, evolução por sessão, hipóteses diagnósticas, plano terapêutico e história clínica — campos prontos pra prática profissional.' },
  { icon: 'KeyRound' as const, title: 'Acesso por permissão (RBAC)', description: 'Plano Clínica: cada parceiro só vê seus próprios pacientes. Secretária não acessa prontuário. Você define quem vê o quê pelo painel de Equipe.' },
  { icon: 'Lock' as const, title: 'Trilha de auditoria por paciente', description: 'Cada visualização e edição de prontuário fica registrada com usuário, timestamp e tipo de ação. Útil pra LGPD, fiscalização do CRP e investigação interna.' },
  { icon: 'FileText' as const, title: 'Editor rico (TipTap/WYSIWYG)', description: 'Formatação livre como num editor profissional, com checklist, destaques, listas e organização visual da evolução.' },
  { icon: 'Repeat' as const, title: 'Portabilidade total', description: 'Exporte tudo em formato aberto a qualquer momento. Sem refém — pacientes, sessões, prontuários, recibos saem com você.' },
];

const faqs = [
  { q: 'Atende a Resolução CFP nº 01/2009?', a: 'Sim. Registro datado, identificado, fidedigno e com trilha de alterações — princípios centrais da Resolução. Adicionalmente, controle de acesso por papel atende ao princípio de sigilo profissional.' },
  { q: 'Posso usar pra atendimento online (CFP 11/2018)?', a: 'Sim. O sistema é parte da plataforma adequada pra atendimento online: registra a sessão, mantém o sigilo (RBAC, TLS 1.3) e permite gerar comprovante quando necessário.' },
  { q: 'Como funciona o backup do prontuário?', a: 'Snapshot diário do banco em Cloud Storage com retenção. A infraestrutura de armazenamento aplica criptografia em disco no nível do provedor.' },
  { q: 'O paciente pode acessar o prontuário pelo portal?', a: 'Não, por padrão. O portal mostra agendamentos, mood log e anamnese — não evolução. Se quiser dar acesso a alguma anotação específica, envia como documento (recibo/declaração).' },
  { q: 'Como sair do sistema sem perder histórico?', a: 'Exportação completa em formato aberto a qualquer momento — pacientes, sessões, prontuários, recibos. Sem refém.' },
];
---

<BaseLayout title={title} description={description}>
  <FeatureLanding
    feature={feature}
    h1="Prontuário <span class='text-blue-600'>auditável</span> e dentro da lei"
    intro="Registro clínico tratado com o rigor que o sigilo profissional exige: estruturado, auditável e portátil. Sem comprometer a velocidade da escrita no dia a dia."
    benefits={benefits}
    faqs={faqs}
  />
  <CTA />
</BaseLayout>
