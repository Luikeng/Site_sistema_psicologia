---
// Layout do visual novo (out/2026). Sem Tailwind e sem fonte para baixar: usa a
// fonte do próprio aparelho, como o sistema. A medição (Google Ads, Pixel da Meta,
// GA4 e Clarity) é a mesma do BaseLayout, mas só entra no site publicado
// (npm run build); em desenvolvimento nada dispara, para não sujar as campanhas.
import '../styles/novo.css';
import SEO from '../components/SEO.astro';
import Icones from '../components/novo/Icones.astro';
import BalaoAjuda from '../components/novo/BalaoAjuda.astro';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const { title, description, canonical, image, noindex, jsonLd } = Astro.props;

const PROD = import.meta.env.PROD;
const ga4Id = import.meta.env.PUBLIC_GA4_ID || (PROD ? 'G-PN3CP1BTLG' : '');
const clarityId = import.meta.env.PUBLIC_CLARITY_ID || (PROD ? 'x3vd1tcpf5' : '');
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="facebook-domain-verification" content="0rioinfbtmscd36yx16d29g525zgeh" />
    <meta name="theme-color" content="#0f172a" />
    <SEO title={title} description={description} canonical={canonical} image={image} noindex={noindex} jsonLd={jsonLd} />

    {/* Mesmas tags do BaseLayout (Google Ads AW-18119618300, Pixel 1325016305630042, GA4, Clarity).
        Só no site publicado e só no domínio real: abrir o build no computador (astro preview)
        não manda visita falsa para as campanhas. */}
    {PROD && (
      <script is:inline set:html={`
        (function () {
          if (!/(^|\\.)sistemapsicologia\\.com\\.br$/.test(location.hostname)) return;
          function carrega(src) { var s = document.createElement('script'); s.async = true; s.src = src; document.head.appendChild(s); }
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { dataLayer.push(arguments); };
          gtag('js', new Date());
          carrega('https://www.googletagmanager.com/gtag/js?id=AW-18119618300');
          gtag('config', 'AW-18119618300');
          ${ga4Id ? `gtag('config', '${ga4Id}', { cookie_domain: '.sistemapsicologia.com.br', cookie_flags: 'SameSite=None;Secure' });` : ''}
          !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
          n.callMethod.apply(n,arguments):n.queue.push(arguments)};
          if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
          n.queue=[];t=b.createElement(e);t.async=!0;
          t.src=v;s=b.getElementsByTagName(e)[0];
          s.parentNode.insertBefore(t,s)}(window, document,'script','https://connect.facebook.net/en_US/fbevents.js');
          fbq('init', '1325016305630042');
          fbq('track', 'PageView');
          ${clarityId ? `(function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);})(window, document, "clarity", "script", "${clarityId}");` : ''}
        })();
      `}></script>
    )}
    {PROD && (
      <noscript>
        <img height="1" width="1" style="display:none" alt=""
          src="https://www.facebook.com/tr?id=1325016305630042&ev=PageView&noscript=1" />
      </noscript>
    )}
  </head>
  <body>
    <a class="pular" href="#inicio">Pular para o conteúdo</a>
    <Icones />
    <slot />
    <BalaoAjuda />
  </body>
</html>
