---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  bodyClass?: string;
}

const { title, description, canonical, image, noindex, jsonLd, bodyClass = '' } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      image={image}
      noindex={noindex}
      jsonLd={jsonLd}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Google Ads tag (gtag.js) — conta Sistema Psicologia (7416902600).
         Captura gclid de cliques em ads e seta cookie cross-subdomain
         (.sistemapsicologia.com.br) pro app atribuir a conversao no signup. -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-18119618300"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'AW-18119618300');
    </script>

    <!-- Meta Pixel — "Sistema Psicologia Pixel" (ID 1325016305630042, criado 07/06/2026).
         Trackea PageView em toda a landing. CompleteRegistration e
         disparado dentro do app React no callback de signup. Cookie do
         Meta tambem fica em .sistemapsicologia.com.br pra atribuir cross-
         subdomain (landing -> sistema.sistemapsicologia.com.br). -->
    <script is:inline>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '1325016305630042');
      fbq('track', 'PageView');
    </script>
    <noscript>
      <img height="1" width="1" style="display:none"
        src="https://www.facebook.com/tr?id=1325016305630042&ev=PageView&noscript=1" />
    </noscript>
  </head>
  <body class={`min-h-screen font-sans antialiased text-gray-900 bg-[#FAFAFA] overflow-x-hidden ${bodyClass}`}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:bg-blue-600 focus:text-white focus:px-4 focus:py-2 focus:rounded-md"
    >
      Pular para o conteúdo
    </a>
    <Navbar />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
