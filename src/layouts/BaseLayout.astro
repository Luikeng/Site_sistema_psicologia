---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  bodyClass?: string;
}

const { title, description, canonical, image, noindex, jsonLd, bodyClass = '' } = Astro.props;

// Analytics — IDs publicos (aparecem no HTML/Network, nao sao segredo).
// So ativa em PROD (npm run build); em dev local (npm run dev) fica off
// pra nao contaminar a property real com sessoes de desenvolvimento.
// Env var PUBLIC_GA4_ID / PUBLIC_CLARITY_ID podem sobrescrever (ex: staging).
const GA4_ID_DEFAULT = 'G-PN3CP1BTLG';  // Property "Sistema Psicologia" (criada 08/06/2026)
const CLARITY_ID_DEFAULT = 'x3vd1tcpf5'; // Projeto "sistema psicologia" (criado 08/06/2026)
const ga4Id = import.meta.env.PUBLIC_GA4_ID || (import.meta.env.PROD ? GA4_ID_DEFAULT : '');
const clarityId = import.meta.env.PUBLIC_CLARITY_ID || (import.meta.env.PROD ? CLARITY_ID_DEFAULT : '');
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Meta domain verification — vincula sistemapsicologia.com.br ao
         Business Manager "Sistema Psicologia" (ID 938115235893774). Necessario
         pra liberar Aggregated Event Measurement (limite iOS 14+) e marcar
         CompleteRegistration como evento de conversao priorizada. -->
    <meta name="facebook-domain-verification" content="0rioinfbtmscd36yx16d29g525zgeh" />
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      image={image}
      noindex={noindex}
      jsonLd={jsonLd}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Google Ads tag (gtag.js) — conta Sistema Psicologia (7416902600).
         Captura gclid de cliques em ads e seta cookie cross-subdomain
         (.sistemapsicologia.com.br) pro app atribuir a conversao no signup. -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-18119618300"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'AW-18119618300');
    </script>

    <!-- Meta Pixel — "Sistema Psicologia Pixel" (ID 1325016305630042) na
         conta de ads act_1313929800232774 (Business Manager Sistema Psicologia,
         setup novo via MCP Meta Ads). Pixel anterior 1914855498692007 ficou em
         outro BM/conta antiga (irrelevante). CompleteRegistration dispara no
         signup (fbpixel.ts) — esse eh o evento que otimiza as campanhas.
         Trackea PageView em toda a landing. CompleteRegistration e
         disparado dentro do app React no callback de signup. Cookie do
         Meta tambem fica em .sistemapsicologia.com.br pra atribuir cross-
         subdomain (landing -> sistema.sistemapsicologia.com.br). -->
    <script is:inline>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '1325016305630042');
      fbq('track', 'PageView');
    </script>
    <noscript>
      <img height="1" width="1" style="display:none"
        src="https://www.facebook.com/tr?id=1325016305630042&ev=PageView&noscript=1" />
    </noscript>

    {/* Google Analytics 4 (opt-in via PUBLIC_GA4_ID). Mede trafego, funil,
        demografia, dispositivo, origem (orgânico/social/ads/referral). No-op
        se variavel nao setada — nao renderiza script nenhum. Cookie cross-
        subdomain (.sistemapsicologia.com.br) preserva sessao landing -> app. */}
    {ga4Id && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}></script>
        <script is:inline set:html={`
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', '${ga4Id}', {
            cookie_domain: '.sistemapsicologia.com.br',
            cookie_flags: 'SameSite=None;Secure'
          });
        `}></script>
      </>
    )}

    {/* Microsoft Clarity (opt-in via PUBLIC_CLARITY_ID). Session replay + heatmap.
        Mostra video anonimizado de cada visitante, rage clicks, fricçao na UI.
        100% grátis, LGPD-friendly (anonimiza dados pessoais automaticamente).
        No-op se nao setado. */}
    {clarityId && (
      <script is:inline set:html={`
        (function(c,l,a,r,i,t,y){
            c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
            t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
            y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        })(window, document, "clarity", "script", "${clarityId}");
      `}></script>
    )}
  </head>
  <body class={`min-h-screen font-sans antialiased text-gray-900 bg-[#FAFAFA] overflow-x-hidden ${bodyClass}`}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:bg-blue-600 focus:text-white focus:px-4 focus:py-2 focus:rounded-md"
    >
      Pular para o conteúdo
    </a>
    <Navbar />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
