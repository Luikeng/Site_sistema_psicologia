---
import { SITE } from '../data/site.ts';

export interface Props {
  title?: string;
  subtitle?: string;
  primary?: string;
  secondary?: string;
}

const {
  title = 'Pronto pra desburocratizar sua clínica?',
  subtitle = 'Crie a conta sem cartão e veja o sistema funcionar com seus dados em menos de 10 minutos.',
  primary = 'Começar teste grátis',
  secondary = 'Falar com vendas',
} = Astro.props;
---

<section class="py-20 lg:py-24 bg-gradient-to-br from-blue-600 to-indigo-700 relative overflow-hidden">
  <div class="absolute inset-0 opacity-10" aria-hidden="true">
    <div class="absolute -top-32 -left-32 w-96 h-96 bg-white rounded-full blur-3xl"></div>
    <div class="absolute -bottom-32 -right-32 w-96 h-96 bg-white rounded-full blur-3xl"></div>
  </div>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative">
    <h2 class="text-3xl lg:text-4xl font-bold text-white mb-4 tracking-tight text-balance">{title}</h2>
    <p class="text-lg text-blue-100 mb-8 max-w-2xl mx-auto leading-relaxed">{subtitle}</p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
      <a
        href={SITE.appUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-cta="cta-primary"
        class="w-full sm:w-auto bg-white text-blue-700 px-7 py-3.5 rounded-xl font-bold hover:bg-gray-50 transition-colors shadow-lg inline-flex items-center justify-center gap-2"
      >
        {primary}
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
      <a
        href="/contato"
        class="w-full sm:w-auto bg-blue-700/40 text-white border border-white/30 px-7 py-3.5 rounded-xl font-bold hover:bg-blue-700/60 transition-colors backdrop-blur-sm inline-flex items-center justify-center"
      >
        {secondary}
      </a>
    </div>
  </div>
</section>
