---
// Mockup do Financeiro do Sistema Psicologia.
// Mostra: navegação mensal, resumo (faturamento previsto vs realizado vs
// inadimplência), lista de sessões com status de pagamento.
// Pure-Astro, zero JS.

const sessions = [
  { date: '14/05', time: '14:00', patient: 'Ana M.', value: 'R$ 220', status: 'paid' },
  { date: '14/05', time: '15:00', patient: 'Carlos P.', value: 'R$ 220', status: 'paid' },
  { date: '14/05', time: '16:00', patient: 'Mariana S.', value: 'R$ 220', status: 'pending' },
  { date: '15/05', time: '09:00', patient: 'Lucas V.', value: 'R$ 220', status: 'paid' },
  { date: '15/05', time: '10:00', patient: 'Júlia R.', value: 'R$ 180', status: 'paid' },
  { date: '15/05', time: '14:00', patient: 'Pedro L.', value: 'R$ 220', status: 'pending' },
  { date: '16/05', time: '11:00', patient: 'Fernanda T.', value: 'R$ 220', status: 'paid' },
];

const statusMap = {
  paid: { label: 'Pago', color: 'bg-emerald-50 text-emerald-700 border-emerald-200' },
  pending: { label: 'Pendente', color: 'bg-amber-50 text-amber-700 border-amber-200' },
};
---

<div class="w-full h-full flex flex-col bg-white rounded-xl border border-gray-100 overflow-hidden shadow-sm">
  <!-- Header -->
  <div class="px-4 py-3 border-b border-gray-100 flex items-center justify-between">
    <h2 class="text-sm font-extrabold text-gray-900">💰 Financeiro</h2>
    <div class="flex items-center gap-1.5">
      <button class="w-6 h-6 rounded border border-gray-200 text-gray-500 text-xs font-bold flex items-center justify-center">‹</button>
      <span class="text-xs font-semibold text-gray-900 px-2">Maio 2026</span>
      <button class="w-6 h-6 rounded border border-gray-200 text-gray-500 text-xs font-bold flex items-center justify-center">›</button>
    </div>
  </div>

  <!-- 3 cards de resumo -->
  <div class="px-4 py-3 grid grid-cols-3 gap-3">
    <div class="bg-blue-50 border border-blue-100 rounded-xl p-3">
      <div class="text-[10px] uppercase tracking-wider text-blue-700 font-semibold">Previsto</div>
      <div class="text-lg font-extrabold text-blue-900 mt-1 leading-none">R$ 5.280</div>
      <div class="text-[10px] text-blue-700 mt-1">24 sessões</div>
    </div>
    <div class="bg-emerald-50 border border-emerald-100 rounded-xl p-3">
      <div class="text-[10px] uppercase tracking-wider text-emerald-700 font-semibold">Realizado</div>
      <div class="text-lg font-extrabold text-emerald-900 mt-1 leading-none">R$ 3.960</div>
      <div class="text-[10px] text-emerald-700 mt-1">18 pagos</div>
    </div>
    <div class="bg-amber-50 border border-amber-100 rounded-xl p-3">
      <div class="text-[10px] uppercase tracking-wider text-amber-700 font-semibold">Pendente</div>
      <div class="text-lg font-extrabold text-amber-900 mt-1 leading-none">R$ 1.320</div>
      <div class="text-[10px] text-amber-700 mt-1">6 a receber</div>
    </div>
  </div>

  <!-- Filtros -->
  <div class="px-4 pb-2 flex items-center gap-2 text-[10px]">
    <span class="text-gray-500 font-semibold">FILTROS:</span>
    <div class="px-2 py-1 bg-gray-50 border border-gray-200 rounded-md text-gray-700 font-medium">Todos os pacientes ▾</div>
    <div class="px-2 py-1 bg-gray-50 border border-gray-200 rounded-md text-gray-700 font-medium">Status: Todos ▾</div>
  </div>

  <!-- Tabela de sessões -->
  <div class="flex-1 overflow-hidden flex flex-col">
    <div class="grid grid-cols-[80px_60px_1fr_80px_80px] gap-3 px-4 py-2 border-b border-gray-100 text-[10px] uppercase tracking-wider text-gray-500 font-semibold">
      <div>Data</div>
      <div>Hora</div>
      <div>Paciente</div>
      <div class="text-right">Valor</div>
      <div class="text-right">Status</div>
    </div>
    <div class="flex-1 overflow-hidden">
      {sessions.map((s) => (
        <div class="grid grid-cols-[80px_60px_1fr_80px_80px] gap-3 px-4 py-2.5 border-b border-gray-50 items-center text-xs">
          <div class="text-gray-700 font-medium">{s.date}</div>
          <div class="text-gray-600">{s.time}</div>
          <div class="font-semibold text-gray-900 truncate">{s.patient}</div>
          <div class="text-right text-gray-900 font-bold">{s.value}</div>
          <div class="text-right">
            <span class={`inline-block text-[9px] font-semibold px-2 py-0.5 rounded border ${statusMap[s.status as keyof typeof statusMap].color}`}>
              {statusMap[s.status as keyof typeof statusMap].label}
            </span>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Footer com atalhos -->
  <div class="px-4 py-2.5 border-t border-gray-100 flex items-center justify-between bg-gray-50">
    <div class="flex items-center gap-3 text-[10px] text-gray-600">
      <span class="font-semibold">📊 Exportar relatório</span>
      <span class="text-gray-300">|</span>
      <span class="font-semibold">📄 Gerar Receita Saúde</span>
    </div>
    <button class="text-[11px] font-bold text-white bg-blue-600 px-3 py-1.5 rounded-lg">+ Lançar Avulso</button>
  </div>
</div>
