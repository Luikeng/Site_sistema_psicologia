---
// Mockup do Portal do Paciente — vista do PACIENTE quando faz login.
// Mostra: header com nome, diário de humor (emojis), próximas sessões,
// pagamento pendente, cards de Agendamentos, Senha, Anamnese, Notas
// Fiscais. Pure-Astro, zero JS.

const moods = [
  { label: 'Muito mal', emoji: '😢', selected: false },
  { label: 'Mal', emoji: '😞', selected: false },
  { label: 'Neutro', emoji: '😐', selected: false },
  { label: 'Bem', emoji: '🙂', selected: false },
  { label: 'Muito bem', emoji: '😊', selected: true },
];
---

<div class="w-full h-full flex flex-col bg-[#FAFAFA] rounded-xl border border-gray-100 overflow-hidden shadow-sm">
  <!-- Header com header simples (paciente não vê sidebar) -->
  <div class="bg-white border-b border-gray-100 px-5 py-3 flex items-center justify-between">
    <div class="flex items-center gap-2">
      <div class="w-7 h-7 rounded-lg bg-gradient-to-br from-blue-600 to-indigo-600 flex items-center justify-center text-white font-bold text-[10px]">SP</div>
      <span class="text-xs font-bold text-gray-900">Portal do Paciente</span>
    </div>
    <div class="flex items-center gap-2 text-[10px] text-gray-600">
      <div class="w-6 h-6 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-[10px]">MS</div>
      <span class="font-semibold">Mariana S.</span>
    </div>
  </div>

  <!-- Conteúdo scrollable -->
  <div class="flex-1 overflow-hidden px-5 py-4 space-y-3">
    <!-- Diário de humor -->
    <div class="bg-white rounded-xl border border-gray-100 p-4">
      <div class="flex items-center justify-between mb-2">
        <div>
          <h3 class="text-xs font-bold text-gray-900">Como você está hoje?</h3>
          <p class="text-[10px] text-gray-500 mt-0.5">Registro de humor — só você e seu profissional veem</p>
        </div>
        <span class="text-[10px] text-emerald-700 font-semibold">✓ Registrado hoje</span>
      </div>
      <div class="grid grid-cols-5 gap-2">
        {moods.map((m) => (
          <button class:list={[
            'flex flex-col items-center gap-1 py-2.5 rounded-lg border',
            m.selected ? 'bg-emerald-50 border-emerald-300' : 'bg-gray-50 border-transparent',
          ]}>
            <span class="text-xl">{m.emoji}</span>
            <span class={`text-[9px] font-semibold ${m.selected ? 'text-emerald-700' : 'text-gray-500'}`}>{m.label}</span>
          </button>
        ))}
      </div>
      <!-- Mini barra de últimos 14 dias -->
      <div class="mt-3 pt-3 border-t border-gray-100">
        <div class="flex items-end gap-0.5 h-6">
          {[60, 70, 65, 80, 50, 75, 85, 70, 90, 65, 80, 95, 85, 90].map((h) => (
            <div class={`flex-1 rounded-sm ${h >= 80 ? 'bg-emerald-400' : h >= 60 ? 'bg-amber-300' : 'bg-rose-300'}`} style={`height: ${h}%`}></div>
          ))}
        </div>
        <p class="text-[9px] text-gray-400 text-center mt-1">Últimos 14 dias</p>
      </div>
    </div>

    <!-- Pagamento pendente -->
    <div class="bg-amber-50 border border-amber-100 rounded-xl px-4 py-2.5 flex items-center justify-between">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-full bg-amber-100 flex items-center justify-center text-base">💰</div>
        <div>
          <div class="text-xs font-bold text-amber-900">Pagamento Pendente</div>
          <div class="text-[10px] text-amber-700">2 sessões em aberto</div>
        </div>
      </div>
      <div class="text-right">
        <div class="text-base font-extrabold text-amber-900">R$ 440</div>
      </div>
    </div>

    <!-- Cards de atalhos -->
    <div class="grid grid-cols-3 gap-2">
      {[
        { icon: '📅', title: 'Agendamentos', desc: 'Veja suas sessões' },
        { icon: '🔒', title: 'Senha de acesso', desc: '✓ Senha ativa' },
        { icon: '📋', title: 'Anamnese', desc: 'Preencher agora' },
        { icon: '📄', title: 'Notas Fiscais', desc: 'Baixar NFS-e' },
        { icon: '📁', title: 'Documentos', desc: 'Atestados, laudos' },
        { icon: '⏰', title: 'Próxima sessão', desc: 'Em 3 dias' },
      ].map((card) => (
        <div class="bg-white rounded-xl border border-gray-100 p-3">
          <div class="flex items-start justify-between mb-2">
            <div class="w-7 h-7 rounded-lg bg-blue-50 flex items-center justify-center text-sm">{card.icon}</div>
            <span class="text-gray-400 text-[10px]">›</span>
          </div>
          <div class="text-[11px] font-bold text-gray-900">{card.title}</div>
          <div class="text-[9px] text-gray-500 mt-0.5">{card.desc}</div>
        </div>
      ))}
    </div>
  </div>
</div>
