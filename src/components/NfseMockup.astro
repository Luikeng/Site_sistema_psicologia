---
// Mockup do módulo NFS-e do Sistema Psicologia (histórico + emissão).
// Mostra: lista de notas emitidas, status, botões de ação (PDF, XML,
// Cancelar). Pure-Astro, zero JS.

const notes = [
  { dps: '74', date: '04/05/2026', sessions: '4 (Abr/2026)', value: 'R$ 800,00', status: 'AUTHORIZED' },
  { dps: '69', date: '08/04/2026', sessions: '3 (Mar/2026)', value: 'R$ 600,00', status: 'AUTHORIZED' },
  { dps: '68', date: '08/04/2026', sessions: '4 (Fev/2026)', value: 'R$ 800,00', status: 'AUTHORIZED' },
  { dps: '67', date: '08/04/2026', sessions: '2 (Jan/2026)', value: 'R$ 400,00', status: 'AUTHORIZED' },
  { dps: '66', date: '08/04/2026', sessions: '2 (Dez/2025)', value: 'R$ 400,00', status: 'AUTHORIZED' },
];

const statusMap = {
  AUTHORIZED: { label: '✓ Autorizada', color: 'bg-emerald-50 text-emerald-700' },
  PENDING: { label: '⏳ Processando', color: 'bg-amber-50 text-amber-700' },
  REJECTED: { label: '✗ Rejeitada', color: 'bg-red-50 text-red-700' },
};
---

<div class="w-full h-full flex flex-col bg-white rounded-xl border border-gray-100 overflow-hidden shadow-sm">
  <!-- Header -->
  <div class="px-4 py-3 border-b border-gray-100 flex items-center justify-between">
    <div>
      <h2 class="text-sm font-extrabold text-gray-900 flex items-center gap-2">
        <span>📄</span> Notas Fiscais
      </h2>
      <p class="text-[10px] text-gray-500 mt-0.5">Histórico de emissões NFS-e Nacional</p>
    </div>
    <button class="text-[11px] font-bold text-white bg-blue-600 px-3 py-1.5 rounded-lg flex items-center gap-1">
      <span>+</span> Emitir Nota
    </button>
  </div>

  <!-- Filtro/busca -->
  <div class="px-4 py-2.5 border-b border-gray-100 flex items-center gap-2 text-[10px]">
    <div class="flex-1 flex items-center gap-1.5 px-2.5 py-1.5 bg-gray-50 border border-gray-200 rounded-md text-gray-500">
      <span>🔍</span>
      <span>Buscar por nº DPS, paciente, mês...</span>
    </div>
    <div class="px-2.5 py-1.5 bg-gray-50 border border-gray-200 rounded-md text-gray-700 font-medium">Período: 2026 ▾</div>
    <div class="px-2.5 py-1.5 bg-gray-50 border border-gray-200 rounded-md text-gray-700 font-medium">Status: Todas ▾</div>
  </div>

  <!-- Tabela -->
  <div class="flex-1 overflow-hidden flex flex-col">
    <div class="grid grid-cols-[60px_90px_1fr_90px_100px_80px] gap-3 px-4 py-2 border-b border-gray-100 text-[10px] uppercase tracking-wider text-gray-500 font-semibold">
      <div>Nº DPS</div>
      <div>Data</div>
      <div>Sessões</div>
      <div class="text-right">Valor</div>
      <div>Status</div>
      <div class="text-center">Ações</div>
    </div>
    {notes.map((n) => (
      <div class="grid grid-cols-[60px_90px_1fr_90px_100px_80px] gap-3 px-4 py-2.5 border-b border-gray-50 items-center text-xs">
        <div class="font-bold text-gray-900">#{n.dps}</div>
        <div class="text-gray-600">{n.date}</div>
        <div class="text-gray-700 truncate">{n.sessions}</div>
        <div class="text-right font-bold text-gray-900">{n.value}</div>
        <div>
          <span class={`inline-block text-[9px] font-semibold px-2 py-0.5 rounded ${statusMap[n.status as keyof typeof statusMap].color}`}>
            {statusMap[n.status as keyof typeof statusMap].label}
          </span>
        </div>
        <div class="flex items-center justify-center gap-1">
          <button class="w-6 h-6 rounded border border-gray-200 text-gray-500 text-[10px] flex items-center justify-center" title="Baixar PDF">📄</button>
          <button class="w-6 h-6 rounded border border-gray-200 text-gray-500 text-[10px] flex items-center justify-center" title="Baixar XML">📋</button>
        </div>
      </div>
    ))}
  </div>

  <!-- Footer com integração gov.br -->
  <div class="px-4 py-2.5 border-t border-gray-100 flex items-center justify-between bg-gray-50">
    <div class="flex items-center gap-1.5 text-[10px] text-gray-600">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
      <span class="font-semibold">Conectado ao Portal Nacional NFS-e (gov.br)</span>
    </div>
    <span class="text-[10px] text-gray-500">Cert. digital · A1 · Válido até 12/2027</span>
  </div>
</div>
