---
import Icon from './Icon.astro';
---

<section id="documentos" class="py-20 lg:py-24 bg-white relative overflow-hidden border-t border-gray-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-blue-50 text-blue-700 font-semibold text-[10px] uppercase tracking-widest mb-6">
          ⚡ Editor profissional
        </div>
        <h2 class="text-3xl lg:text-5xl font-bold text-gray-900 mb-5 leading-tight tracking-tight text-balance">
          Recibo, atestado e declaração <span class="text-blue-600">prontos</span>
        </h2>
        <p class="text-lg text-gray-600 mb-8 leading-relaxed">
          Editor estilo Word com modelos prontos. As variáveis (nome, CPF, valor, data, CRP) são preenchidas automaticamente a partir do paciente — você só revisa e emite.
        </p>

        <div class="space-y-5">
          {[
            { icon: 'FileText', t: 'Editor WYSIWYG completo', d: 'Formatação rica, imagens redimensionáveis e alinhamento profissional. Salve modelos personalizados por workspace.' },
            { icon: 'Briefcase', t: 'Variáveis dinâmicas validadas', d: 'CPF, CRP, valor monetário e datas (mesmo retroativas) validados automaticamente. Adeus erro de digitação.' },
            { icon: 'BookText', t: 'Modelos prontos personalizáveis', d: 'Recibo, atestado, declaração e relatório a partir de templates oficiais — adapte ao seu jeito de escrever.' },
          ].map((item) => (
            <div class="flex gap-4">
              <div class="flex-shrink-0 w-11 h-11 rounded-xl bg-blue-50 border border-blue-100 flex items-center justify-center text-blue-600 shadow-sm">
                <Icon name={item.icon as any} class="w-5 h-5" />
              </div>
              <div>
                <h3 class="text-base font-bold text-gray-900 mb-1">{item.t}</h3>
                <p class="text-sm text-gray-600 leading-relaxed">{item.d}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="relative">
        <div class="bg-gray-50 rounded-3xl p-5 border border-gray-200 shadow-xl">
          <div class="flex items-center gap-2 mb-3 border-b border-gray-200 pb-3">
            <div class="w-2.5 h-2.5 rounded-full bg-gray-300"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-gray-300"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-gray-300"></div>
            <div class="ml-3 text-[10px] text-gray-500 font-medium uppercase tracking-wider">Recibo_Psicologia.pdf</div>
          </div>
          <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-7 min-h-[360px] text-gray-800">
            <div class="flex justify-between items-start mb-7">
              <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-full bg-gradient-to-br from-blue-500 to-indigo-500 text-white font-bold flex items-center justify-center">M</div>
                <div>
                  <h4 class="font-bold text-gray-900 text-sm">Dr(a). Maria Silva</h4>
                  <p class="text-xs text-gray-500">CRP: 07/00000</p>
                </div>
              </div>
              <div class="text-right">
                <p class="font-bold text-blue-600 text-lg">RECIBO</p>
                <p class="text-[10px] text-gray-400">Nº 2026-089</p>
              </div>
            </div>

            <p class="mb-3 leading-relaxed text-sm">
              Recebi de <span class="bg-indigo-50 text-indigo-700 font-medium px-1 rounded border-b border-indigo-300 border-dashed">Ana Beatriz Souza</span>,
              CPF nº <span class="bg-indigo-50 text-indigo-700 font-medium px-1 rounded border-b border-indigo-300 border-dashed">123.456.789-00</span>, a importância de
              <span class="bg-emerald-50 text-emerald-700 font-medium px-1 rounded border-b border-emerald-300 border-dashed">R$ 220,00</span>
              referente a sessão de psicoterapia em <span class="bg-indigo-50 text-indigo-700 font-medium px-1 rounded border-b border-indigo-300 border-dashed">15/05/2026</span>.
            </p>
            <div class="mt-12 text-center">
              <div class="w-44 h-px bg-gray-300 mx-auto mb-2"></div>
              <p class="text-[10px] text-gray-400 font-medium uppercase tracking-wider">Assinatura do profissional</p>
            </div>
          </div>
        </div>

        <div class="absolute -left-6 top-1/2 p-5 bg-white/95 backdrop-blur-xl border border-white shadow-[0_10px_40px_rgba(0,0,0,0.12)] rounded-2xl hidden lg:block w-64">
          <p class="text-[10px] font-bold text-blue-600 uppercase tracking-widest mb-4">Revisar e emitir</p>
          <div class="space-y-3">
            <div>
              <label class="text-[11px] font-semibold text-gray-700 block mb-1">Valor (R$)</label>
              <input type="text" value="220,00" readonly class="w-full text-xs py-2 px-3 rounded-lg border border-gray-200 bg-gray-50 text-gray-800" />
            </div>
            <div>
              <label class="text-[11px] font-semibold text-gray-700 block mb-1">Data</label>
              <input type="text" value="15/05/2026" readonly class="w-full text-xs py-2 px-3 rounded-lg border border-gray-200 bg-gray-50 text-gray-800" />
            </div>
          </div>
          <button class="mt-4 w-full bg-blue-600 text-white text-xs py-2.5 rounded-xl font-bold flex justify-center gap-2 items-center shadow-md">
            Emitir documento
          </button>
        </div>
      </div>
    </div>
  </div>
</section>
