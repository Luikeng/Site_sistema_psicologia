---
import { SITE } from '../data/site.ts';
import DashboardMockup from './DashboardMockup.astro';
---

<section class="relative pt-28 pb-20 lg:pt-36 lg:pb-28 overflow-hidden border-b border-gray-100/50 bg-white">
  <video
    autoplay
    loop
    muted
    playsinline
    aria-hidden="true"
    class="absolute inset-0 w-full h-full object-cover opacity-60 pointer-events-none z-0"
  >
    <source src="/hero-bg.mp4" type="video/mp4" />
  </video>
  <div class="absolute inset-0 bg-gradient-to-b from-white/70 via-white/50 to-white/90 pointer-events-none z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-20">
    <div class="text-center max-w-4xl mx-auto">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-50 text-emerald-700 font-medium text-xs tracking-wide mb-8 border border-emerald-100/50">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
        CONFORMIDADE LGPD ATIVA · NFS-E · RECEITA SAÚDE
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-gray-900 tracking-tight mb-6 leading-[1.1] mx-auto max-w-4xl text-balance">
        O sistema de gestão para psicólogos que faz <span class="text-blue-600">tudo num lugar só</span>.
      </h1>

      <p class="text-lg lg:text-xl text-gray-600 mb-10 max-w-2xl mx-auto leading-relaxed text-balance">
        Agenda integrada ao Google, prontuário LGPD, <strong class="text-gray-900 font-semibold">NFS-e</strong>, <strong class="text-gray-900 font-semibold">Receita Saúde</strong>, financeiro e portal do paciente. Tire o consultório do papel e do WhatsApp.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href={SITE.appUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-cta="hero-primary"
          class="w-full sm:w-auto bg-blue-600 text-white px-8 py-3.5 rounded-xl font-semibold hover:bg-blue-700 transition-all shadow-[0_4px_14px_rgba(37,99,235,0.4)] text-base hover:-translate-y-0.5 text-center inline-flex items-center justify-center gap-2"
        >
          Começar teste grátis
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        <a
          href="/recursos"
          class="w-full sm:w-auto bg-white text-gray-900 px-8 py-3.5 rounded-xl font-semibold hover:bg-gray-50 transition-all border border-gray-200 text-base shadow-sm text-center inline-flex items-center justify-center"
        >
          Ver todos os recursos
        </a>
      </div>

      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6 text-sm text-gray-600 font-medium">
        <span class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Sem cartão pra começar</span>
        <span class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Migração assistida</span>
        <span class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Cancela quando quiser</span>
      </div>
    </div>

    <div class="mt-16 lg:mt-20 relative mx-auto max-w-5xl lg:max-w-6xl">
      <div class="absolute inset-0 bg-blue-500/5 rounded-[32px] blur-2xl translate-y-6"></div>
      <div class="relative rounded-[24px] bg-gray-100/60 p-2 sm:p-3 border border-white/60 shadow-[0_20px_50px_rgba(0,0,0,0.08)] overflow-hidden backdrop-blur-sm">
        <div class="bg-white rounded-[16px] overflow-hidden flex h-[420px] lg:h-[560px] shadow-sm relative border border-gray-200/60 ring-1 ring-black/5">
          <DashboardMockup />
          <div class="absolute inset-0 bg-gradient-to-t from-white/40 to-transparent pointer-events-none hidden sm:block"></div>
        </div>
      </div>
    </div>
  </div>
</section>
