---
import Icon from './Icon.astro';

const steps = [
  {
    icon: 'CalendarLink',
    label: '1. Paciente marca sozinho',
    pitch: 'Link público estilo Cal.com',
    description: 'Divulgue o link curto no Instagram, Google Maps ou embed no seu site. Paciente novo escolhe horário em slots de tempo real, preenche 3 campos e é auto-cadastrado. Você aprova ou recebe automático — depende do toggle.',
    color: 'violet',
  },
  {
    icon: 'ClipboardEdit',
    label: '2. Anamnese digital',
    pitch: 'Antes da 1ª sessão',
    description: 'Após reservar, paciente recebe link único pra preencher o questionário pelo celular. Histórico clínico chega na sua tela antes do primeiro atendimento.',
    color: 'indigo',
  },
  {
    icon: 'CalendarSync',
    label: '3. Agenda + lembrete',
    pitch: 'Sincroniza com Google',
    description: 'A sessão aparece no Google Calendar do psi e do paciente. Lembrete nativo no horário, com fuso correto pra cada parte. Lembrete extra por e-mail 24h antes.',
    color: 'blue',
  },
  {
    icon: 'BookText',
    label: '4. Sessão + evolução',
    pitch: 'Prontuário aberto',
    description: 'Durante ou após o atendimento, registra evolução no prontuário. Trilha de auditoria por acesso. Anamnese disponível ao lado.',
    color: 'emerald',
  },
  {
    icon: 'Smile',
    label: '5. Acompanhamento',
    pitch: 'Mood log entre sessões',
    description: 'Paciente registra humor diário pelo portal. Você vê a evolução em gráfico antes da próxima consulta.',
    color: 'pink',
  },
  {
    icon: 'WalletCards',
    label: '6. Cobrança',
    pitch: 'Sessão ou mensalidade',
    description: 'Marca como paga ou ativa mensalidade automática. Repasse split (Plano Clínica) calcula a parte do psicólogo na hora.',
    color: 'amber',
  },
  {
    icon: 'FileBadge',
    label: '7. NFS-e ou Receita Saúde',
    pitch: 'Emissão fiscal',
    description: 'Sessão paga vira NFS-e Nacional (1000+ municípios) ou linha do CSV Receita Saúde (Carnê-Leão). Recibo simples como fallback.',
    color: 'sky',
  },
];

const colorMap: Record<string, string> = {
  violet: 'from-violet-500 to-purple-600 ring-violet-200',
  indigo: 'from-indigo-500 to-blue-600 ring-indigo-200',
  blue: 'from-blue-500 to-cyan-600 ring-blue-200',
  emerald: 'from-emerald-500 to-teal-600 ring-emerald-200',
  pink: 'from-pink-500 to-rose-600 ring-pink-200',
  amber: 'from-amber-500 to-orange-600 ring-amber-200',
  sky: 'from-sky-500 to-cyan-600 ring-sky-200',
};
---

<section id="fluxo" class="py-20 lg:py-24 bg-gradient-to-b from-[#F8FAFC] to-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-14">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-50 text-emerald-700 font-semibold text-[10px] uppercase tracking-widest mb-5">
        <Icon name="Repeat" class="w-3.5 h-3.5" />
        Fluxo de ponta a ponta
      </div>
      <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-5 tracking-tight text-balance">
        Do primeiro contato à <span class="text-blue-600">NFS-e emitida</span>
      </h2>
      <p class="text-lg text-gray-600 leading-relaxed">
        Cada etapa do atendimento conectada à seguinte. Sem retrabalho, sem planilha, sem app paralelo. O dado entra uma vez e segue automaticamente até virar nota fiscal.
      </p>
    </div>

    <div class="relative">
      <!-- Linha conectora visual -->
      <div class="hidden lg:block absolute left-1/2 top-12 bottom-12 w-px bg-gradient-to-b from-blue-200 via-purple-200 to-transparent -translate-x-1/2" aria-hidden="true"></div>

      <ol class="space-y-6 lg:space-y-10">
        {steps.map((step, idx) => (
          <li class={`relative grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-12 items-center ${idx % 2 === 1 ? 'lg:[&>div:first-child]:order-2' : ''}`}>
            <div class={`bg-white border border-gray-100 rounded-2xl p-6 lg:p-7 shadow-sm relative ${idx % 2 === 0 ? 'lg:text-right' : ''}`}>
              <div class={`flex items-center gap-3 mb-3 ${idx % 2 === 0 ? 'lg:flex-row-reverse' : ''}`}>
                <div class={`w-12 h-12 rounded-xl bg-gradient-to-br ${colorMap[step.color]} text-white flex items-center justify-center shadow-md flex-shrink-0`}>
                  <Icon name={step.icon as any} class="w-6 h-6" />
                </div>
                <div>
                  <p class="text-[11px] font-bold uppercase tracking-widest text-gray-400">{step.label}</p>
                  <h3 class="text-lg font-bold text-gray-900">{step.pitch}</h3>
                </div>
              </div>
              <p class="text-sm text-gray-600 leading-relaxed">{step.description}</p>
            </div>

            <!-- Bolinha central na linha conectora (desktop) -->
            <div class="hidden lg:flex absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 z-10 items-center justify-center" aria-hidden="true">
              <div class={`w-5 h-5 rounded-full bg-gradient-to-br ${colorMap[step.color]} ring-4 ring-white shadow-md`}></div>
            </div>

            <!-- Espaço fantasma do outro lado em desktop -->
            <div class="hidden lg:block"></div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
