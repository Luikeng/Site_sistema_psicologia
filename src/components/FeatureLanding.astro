---
import Icon from './Icon.astro';
import type { FeatureItem } from '../data/features.ts';
import { SITE } from '../data/site.ts';

export interface Props {
  feature: FeatureItem;
  h1: string;
  intro: string;
  benefits: { title: string; description: string; icon?: FeatureItem['icon'] }[];
  steps?: { title: string; description: string }[];
  faqs?: { q: string; a: string }[];
  relatedSlugs?: string[];
  // Tipo do preview: 'desktop' (default) força min-width 860px com scroll
  // horizontal em mobile pra preservar layout. 'mobile' renderiza no
  // tamanho de celular (max-w-sm centralizado) — ideal pra Portal do
  // Paciente que é mobile-first no app real.
  previewVariant?: 'desktop' | 'mobile';
}

const { feature, h1, intro, benefits, steps, faqs, previewVariant = 'desktop' } = Astro.props;
const isMobilePreview = previewVariant === 'mobile';
---

<header class="pt-32 pb-12 bg-gradient-to-b from-white to-blue-50/40">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    {feature.badge && (
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-blue-50 text-blue-700 font-semibold text-[10px] uppercase tracking-widest mb-5">
        <Icon name={feature.icon} class="w-3.5 h-3.5" /> {feature.badge}
      </div>
    )}
    <h1 class="text-4xl lg:text-5xl font-extrabold text-gray-900 tracking-tight mb-5 text-balance" set:html={h1} />
    <p class="text-lg text-gray-600 max-w-3xl mx-auto leading-relaxed">{intro}</p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mt-8">
      <a
        href={SITE.registerUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-blue-600 text-white px-7 py-3.5 rounded-xl font-semibold hover:bg-blue-700 transition-colors shadow-[0_4px_14px_rgba(37,99,235,0.35)] inline-flex items-center gap-2"
      >
        Começar teste grátis
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
      <a href="/precos" class="text-gray-900 bg-white border border-gray-200 px-7 py-3.5 rounded-xl font-semibold hover:bg-gray-50 transition-colors shadow-sm">
        Ver preços
      </a>
    </div>
  </div>
</header>

{Astro.slots.has('preview') && (
  <section class="pb-12 -mt-4 bg-gradient-to-b from-blue-50/40 to-white">
    <div class={isMobilePreview ? 'max-w-md mx-auto px-4 sm:px-6' : 'max-w-6xl mx-auto px-4 sm:px-6 lg:px-8'}>
      <div class="rounded-2xl bg-white p-2 sm:p-3 border border-gray-200 shadow-[0_12px_40px_rgba(15,23,42,0.08)] overflow-hidden">
        {isMobilePreview ? (
          <!-- Mobile-first mockup (Portal Paciente): renderiza no tamanho nativo, centralizado -->
          <div class="h-[560px] sm:h-[600px]">
            <slot name="preview" />
          </div>
        ) : (
          <!-- Desktop mockup: em mobile, scroll horizontal preserva o layout completo -->
          <div class="overflow-x-auto" style="-webkit-overflow-scrolling: touch;">
            <div class="min-w-[860px] sm:min-w-0 h-[460px] sm:h-[520px] lg:h-[560px]">
              <slot name="preview" />
            </div>
          </div>
        )}
      </div>
      {!isMobilePreview && (
        <p class="text-center text-[11px] text-gray-400 mt-3 sm:hidden">← Arraste para ver a tela completa</p>
      )}
    </div>
  </section>
)}

<section class="py-16 bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 mb-10 text-center tracking-tight">Por que isso muda sua rotina</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {benefits.map((b) => (
        <article class="bg-white border border-gray-100 rounded-2xl p-6 shadow-sm">
          {b.icon && (
            <div class="w-11 h-11 rounded-xl bg-blue-50 border border-blue-100 flex items-center justify-center text-blue-600 mb-4">
              <Icon name={b.icon} class="w-5 h-5" />
            </div>
          )}
          <h3 class="text-base font-bold text-gray-900 mb-2">{b.title}</h3>
          <p class="text-sm text-gray-600 leading-relaxed">{b.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

{steps && steps.length > 0 && (
  <section class="py-16 bg-[#F8FAFC]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 mb-10 text-center tracking-tight">Como funciona, passo a passo</h2>
      <ol class="space-y-5">
        {steps.map((step, idx) => (
          <li class="bg-white border border-gray-100 rounded-2xl p-6 shadow-sm flex gap-5">
            <div class="flex-shrink-0 w-10 h-10 rounded-full bg-blue-600 text-white font-bold text-sm flex items-center justify-center">
              {idx + 1}
            </div>
            <div>
              <h3 class="text-base font-bold text-gray-900 mb-1">{step.title}</h3>
              <p class="text-sm text-gray-600 leading-relaxed">{step.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
)}

{faqs && faqs.length > 0 && (
  <section class="py-16 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 mb-8 text-center tracking-tight">Dúvidas sobre {feature.title}</h2>
      <div class="space-y-3">
        {faqs.map((item, idx) => (
          <details class="group bg-white border border-gray-100 rounded-2xl overflow-hidden shadow-sm" open={idx === 0}>
            <summary class="cursor-pointer list-none flex items-center justify-between gap-4 p-5 font-semibold text-gray-900 hover:bg-gray-50 transition-colors">
              <span class="flex-1">{item.q}</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0 text-gray-400 group-open:rotate-180 transition-transform"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <div class="px-5 pb-5 text-gray-600 leading-relaxed text-[15px] -mt-1">{item.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>
)}
