---
// Mockup da Agenda do Sistema Psicologia.
// Mostra: filtros de Profissionais, botão Sincronizar (com Google), grade
// semanal com sessões coloridas (verde=confirmada, laranja=pendente).
// Pure-Astro, zero JS.

const week = [
  { label: 'Dom', day: 11 },
  { label: 'Seg', day: 12 },
  { label: 'Ter', day: 13, today: true },
  { label: 'Qua', day: 14 },
  { label: 'Qui', day: 15 },
  { label: 'Sex', day: 16 },
  { label: 'Sáb', day: 17 },
];

const hours = ['08:00', '09:00', '10:00', '11:00', '12:00', '13:00', '14:00', '15:00', '16:00'];

// Sessões: { dia (0=Dom..6=Sab), startRow, durationRows, patient, color }
const sessions = [
  { day: 1, row: 1, span: 1, patient: 'Ana M.', color: 'bg-emerald-100 border-l-emerald-500 text-emerald-900' },
  { day: 1, row: 2, span: 1, patient: 'Carlos P.', color: 'bg-emerald-100 border-l-emerald-500 text-emerald-900' },
  { day: 2, row: 0, span: 1, patient: 'Lucas V.', color: 'bg-emerald-100 border-l-emerald-500 text-emerald-900' },
  { day: 2, row: 4, span: 1, patient: 'Mariana S.', color: 'bg-amber-100 border-l-amber-500 text-amber-900' },
  { day: 3, row: 1, span: 1, patient: 'Pedro L.', color: 'bg-emerald-100 border-l-emerald-500 text-emerald-900' },
  { day: 3, row: 3, span: 1, patient: 'Júlia R.', color: 'bg-emerald-100 border-l-emerald-500 text-emerald-900' },
  { day: 4, row: 2, span: 1, patient: 'Fernanda T.', color: 'bg-emerald-100 border-l-emerald-500 text-emerald-900' },
  { day: 5, row: 0, span: 1, patient: 'Rafael C.', color: 'bg-emerald-100 border-l-emerald-500 text-emerald-900' },
  { day: 5, row: 5, span: 1, patient: 'Beatriz N.', color: 'bg-emerald-100 border-l-emerald-500 text-emerald-900' },
];
---

<div class="w-full h-full flex flex-col bg-white rounded-xl border border-gray-100 overflow-hidden shadow-sm">
  <!-- Header -->
  <div class="px-4 py-3 border-b border-gray-100 flex items-center justify-between flex-wrap gap-2">
    <div class="flex items-center gap-2 text-xs">
      <div class="flex border border-gray-200 rounded-lg overflow-hidden">
        <button class="px-3 py-1.5 bg-blue-50 text-blue-700 font-semibold">Semanal</button>
        <button class="px-3 py-1.5 text-gray-600">Mensal</button>
      </div>
    </div>
    <div class="flex items-center gap-2 text-xs">
      <div class="flex items-center gap-1.5 px-3 py-1.5 border border-gray-200 rounded-lg text-gray-700 font-medium">
        <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
        Profissionais ▾
      </div>
      <div class="flex items-center gap-1.5 px-3 py-1.5 border border-gray-200 rounded-lg text-gray-700 font-medium">
        <span class="text-blue-600">↻</span>
        Sincronizar
      </div>
    </div>
  </div>

  <!-- Toolbar mês + nav -->
  <div class="px-4 py-2.5 border-b border-gray-100 flex items-center justify-between">
    <button class="w-7 h-7 rounded border border-gray-200 text-gray-500 text-sm font-bold flex items-center justify-center">‹</button>
    <h3 class="text-sm font-bold text-gray-900">Maio De 2026</h3>
    <button class="w-7 h-7 rounded border border-gray-200 text-gray-500 text-sm font-bold flex items-center justify-center">›</button>
  </div>

  <!-- Grid header (dias da semana) -->
  <div class="grid grid-cols-[60px_repeat(7,_1fr)] border-b border-gray-100 text-center">
    <div></div>
    {week.map((d) => (
      <div class={`py-2 text-[10px] font-bold ${d.today ? 'text-blue-700' : 'text-gray-500'}`}>
        <div class="uppercase tracking-wider">{d.label}</div>
        <div class:list={[
          'mt-1 mx-auto w-6 h-6 flex items-center justify-center rounded-full text-sm',
          d.today ? 'bg-blue-600 text-white' : 'text-gray-700',
        ]}>{d.day}</div>
      </div>
    ))}
  </div>

  <!-- Grid corpo (horas vs dias) -->
  <div class="flex-1 overflow-hidden relative">
    {hours.map((h, hourIdx) => (
      <div class="grid grid-cols-[60px_repeat(7,_1fr)] border-b border-gray-50" style="height: 14.2857%;">
        <div class="text-[10px] text-gray-400 text-right pr-2 pt-1">{h}</div>
        {week.map((d) => (
          <div class="border-l border-gray-50 relative">
            {sessions
              .filter((s) => s.day === week.indexOf(d) && s.row === hourIdx)
              .map((s) => (
                <div class={`absolute inset-1 rounded border-l-2 px-2 py-1 ${s.color} text-[9px] font-semibold leading-tight`}>
                  <div class="truncate">{s.patient}</div>
                  <div class="text-[8px] opacity-75">{h.replace(':', 'h')}</div>
                </div>
              ))}
          </div>
        ))}
      </div>
    ))}
  </div>

  <!-- Footer com legenda -->
  <div class="px-4 py-2 border-t border-gray-100 flex items-center justify-between text-[10px] text-gray-500">
    <div class="flex items-center gap-3">
      <span class="flex items-center gap-1"><span class="w-2 h-2 bg-emerald-500 rounded-sm"></span> Confirmada</span>
      <span class="flex items-center gap-1"><span class="w-2 h-2 bg-amber-500 rounded-sm"></span> Pendente</span>
    </div>
    <span class="text-blue-600 font-medium">↻ Sincronizado com Google Agenda</span>
  </div>
</div>
